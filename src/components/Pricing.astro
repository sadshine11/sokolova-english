---
import { pricing } from '../content/site';
import PenMark from './PenMark.astro';
---

<section class="section" id="pricing" aria-labelledby="pricing-title">
  <div class="shell rail">
    <aside class="rail-aside">
      <p class="rail-label">Прайс</p>
    </aside>

    <div class="pricing">
      <div class="section-head" data-reveal>
        <h2 id="pricing-title">{pricing.title}</h2>
        <p class="lede">{pricing.lede}</p>
      </div>

      <ul class="list" data-reveal>
        {
          pricing.items.map((item) => (
            <li class:list={['price', item.free && 'price--free']}>
              <span class="price__label">
                <span class="price__name">{item.name}</span>
                <span class="price__spec small muted">{item.spec}</span>
              </span>
              <span class="price__dots" aria-hidden="true" />
              <span class="price__value">
                <span class="price__num num">
                  {item.price}
                  {item.free && <PenMark variant="circle" weight={2} class="price__circle" />}
                </span>
                {item.unit && <span class="price__unit small muted">{item.unit}</span>}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="terms" data-reveal>
        <h3 class="rail-label terms__title">{pricing.termsLabel}</h3>
        <ul class="terms__list">
          {pricing.terms.map((t) => <li class="terms__item small">{t}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .list {
    border-top: 1px solid var(--rule-strong);
  }

  .price {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .price__label {
    display: grid;
    gap: 2px;
  }

  .price__name {
    font-weight: 500;
  }

  .price__spec {
    line-height: 1.4;
  }

  /* Точечный выносной ряд — как в печатном прайсе */
  .price__dots {
    display: none;
    flex: 1;
    border-bottom: 1px dotted var(--rule-strong);
    transform: translateY(-5px);
  }

  .price__value {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex: none;
  }

  .price__num {
    position: relative;
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .price__unit {
    line-height: 1.3;
  }

  .price--free .price__name,
  .price--free .price__num {
    color: var(--green-700);
  }

  .price__num :global(.price__circle) {
    position: absolute;
    left: -12px;
    right: -12px;
    top: -5px;
    bottom: -11px;
    width: auto;
    height: auto;
    color: var(--green-600);
    pointer-events: none;
  }

  /* ── Условия ──────────────────────────────────────────────────────── */
  .terms {
    margin-top: var(--s-6);
  }

  .terms__title {
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--s-4);
  }

  .terms__list {
    display: grid;
    gap: var(--s-3);
  }

  .terms__item {
    position: relative;
    padding-left: var(--s-5);
    color: var(--ink-600);
    line-height: 1.55;
    max-width: 70ch;
  }

  .terms__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 12px;
    height: 1.5px;
    background: var(--ink-200);
  }

  @media (min-width: 640px) {
    .price {
      grid-template-columns: none;
      display: flex;
      align-items: baseline;
      gap: var(--s-4);
      padding-block: var(--s-5);
    }

    .price__label {
      flex: 0 1 auto;
      max-width: 34ch;
    }

    .price__dots {
      display: block;
    }

    .price__num {
      font-size: 1.375rem;
    }

    .price__value {
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
      text-align: right;
    }
  }

  @media (min-width: 900px) {
    .terms {
      margin-top: var(--s-7);
      display: grid;
      grid-template-columns: 160px minmax(0, 1fr);
      gap: var(--s-5);
      align-items: start;
    }

    .terms__title {
      border-bottom: 0;
      padding-bottom: 0;
      margin-bottom: 0;
      padding-top: 3px;
    }
  }
</style>
